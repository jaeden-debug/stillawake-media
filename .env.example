# Must be a verified Resend sender identity, for example:
# StillAwake Media <contact@stillawakemedia.com>
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
RESEND_API_KEY=

# Stripe Checkout. LIVE key — the catalogue this site sells from
# (the sa_*_cad lookup keys) exists in live mode, so a test key resolves
# nothing and every checkout refuses with a 503 rather than charging wrongly.
# Without this set, buy buttons render but report that checkout is
# unavailable and point the visitor at the contact form. Nothing silently
# half-works.
STRIPE_SECRET_KEY=
